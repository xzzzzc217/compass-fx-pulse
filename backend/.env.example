# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=please_fill_in
MYSQL_DB=compass_fx

# ---- LLM ----
# DEFAULT (used if role-specific LLM_CHAT_* / LLM_AGENT_* not set)
LLM_PROVIDER=deepseek
LLM_API_KEY=please_fill_in
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ---- Per-endpoint routing (Phase 3 heterogeneous LLM) ----
# /agent (Function Calling) MUST use a tools-capable model — keep DeepSeek.
LLM_AGENT_API_KEY=please_fill_in
LLM_AGENT_BASE_URL=https://api.deepseek.com/v1
LLM_AGENT_MODEL=deepseek-chat

# /ai (single-turn chat, "慧聚答疑") can showcase the local LoRA Qwen3-1.7B.
# Start it first:  cd llm && python serve.py
# Then uncomment these 3 lines to route /ai through it:
# LLM_CHAT_API_KEY=local-no-auth-needed
# LLM_CHAT_BASE_URL=http://127.0.0.1:8001/v1
# LLM_CHAT_MODEL=qwen3-1.7b-finance

# ---- App ----
PORT=8080
DEBUG=1

# ---- Langfuse observability (Phase 3.4, optional) ----
# Sign up free at https://cloud.langfuse.com → Project Settings → API Keys
# Without these, Agent runs are NOT traced (graceful degradation, no errors).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- RAG (Phase 3) ----
# Both default to CPU to avoid VRAM contention with LoRA serve / Flask
# Override to "cuda" if you have spare VRAM (>4GB free)
RAG_EMBEDDER_DEVICE=cpu
RAG_RERANKER_DEVICE=cpu

# Windows MKL/OpenMP DLL conflict workaround (silent crash fix for sentence_transformers)
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
